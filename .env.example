# Copy this file to .env and fill in your values.
# On Linux/macOS:  cp .env.example .env
# On Windows CMD:  copy .env.example .env
# On Windows PS:   Copy-Item .env.example .env

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=chineselearn
POSTGRES_PASSWORD=chineselearn123
POSTGRES_DB=chineselearn

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chineselearn:chineselearn123@postgres:5432/chineselearn
REDIS_URL=redis://redis:6379/0

# Generate a real secret for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# CORS: the Expo dev server origin (adjust port if needed)
FRONTEND_URL=http://localhost:8081

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the audio directory (default: backend/data/audio)
# AUDIO_DIR=/path/to/audio
